# PostgreSQL connection string. Locally, run `npx prisma dev` for a
# throwaway local Postgres, or point at Railway's Postgres plugin.
DATABASE_URL="postgresql://user:password@localhost:5432/quantravel?schema=public"

# NextAuth.js — generate with: npx auth secret
AUTH_SECRET=""

# Used once by `npm run db:seed` to create the first Owner account.
# Not read at runtime after that — safe to remove from .env afterwards.
OWNER_EMAIL=""
OWNER_PASSWORD=""
OWNER_NAME="Owner"
